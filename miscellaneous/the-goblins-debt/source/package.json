{
  "name": "the-goblins-debt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env server/index.js",
    "dev:client": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:gameplay": "node tests/browser.mjs --full",
    "test:deployment": "node tests/deployment.mjs",
    "test:visual": "node tests/visual.mjs",
    "test:load": "node tests/load.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "vite": "^7.2.2",
    "playwright": "^1.56.1"
  }
}
